# Copy to apps/web/.env. Docker dev works without it (defaults are in docker-compose.yml).
# NEXT_PUBLIC_* values are baked into the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=123Commerce
# Browser -> API (admin panel, placing orders, tracking).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Shown as "call to order" / WhatsApp button. Bangladeshi number, e.g. 01700000000
NEXT_PUBLIC_SUPPORT_PHONE=
# Facebook (Meta) Pixel id. Strongly recommended when running Facebook ads.
NEXT_PUBLIC_META_PIXEL_ID=
# "cloudflare" uses Cloudflare Image Transformations (/cdn-cgi/image). Leave empty to serve originals.
NEXT_PUBLIC_IMAGE_LOADER=

# Server-side (Next server / Cloudflare Worker) -> API. Inside docker this is the service name.
API_INTERNAL_URL=http://api:4000
CACHE_TTL_SECONDS=3600
# Must match the API's CACHE_SYNC_SECRET.
CACHE_SYNC_SECRET=change-me-cache-sync-secret
