# Copy to apps/api/.env. Docker dev works without it (defaults are in docker-compose.yml).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=commerce

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set true in production (HTTPS). Use a parent domain (e.g. .123commerce.com) if web and api are on subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# First admin is created on startup if no admin exists yet.
ADMIN_EMAIL=admin@123commerce.com
ADMIN_PASSWORD=change-me-please

# Used by your product import script (header: x-api-key).
INGEST_API_KEY=change-me-ingest-key

# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Backend -> frontend KV cache sync.
FRONTEND_CACHE_SYNC_URL=http://web:3000/api/cache
CACHE_SYNC_SECRET=change-me-cache-sync-secret

# Cloudflare R2 (presigned uploads). Leave empty to disable uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

DELIVERY_FEE_INSIDE_DHAKA=70
DELIVERY_FEE_OUTSIDE_DHAKA=130
